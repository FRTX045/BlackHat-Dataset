# Build output. Full logs are published as release assets, not committed.
__pycache__/
*.pyc
.venv/

datasets/**/access.log
datasets/**/access.raw.log
datasets/**/access.tagged.log
# Apache's own combined log, kept beside the derived one so the verifier can
# compare them and a reader can check the comparison.
datasets/**/access.apache.log
datasets/**/error.log
datasets/**/truth.jsonl
# The truth file for the capture, when timestamps were remapped. Same size as
# truth.jsonl and published the same way.
datasets/**/truth.raw.jsonl
# Release assets, built by tools/package.py and published rather than
# committed. SHA256SUMS is regenerated with them.
datasets/**/*.xz
datasets/**/*.zst
datasets/**/SHA256SUMS

projects/*/server/logs/
projects/*/traffic/ledger/
projects/*/app/data/*.sqlite
# Written by the seeder so the traffic driver knows the shape of the catalogue
# without having to ask the running server for it.
projects/*/app/data/catalogue.json
projects/*/app/uploads/*
!projects/*/app/uploads/.gitkeep

# Catalogue assets, generated deterministically from the run seed by the
# container entrypoint. Twenty-odd megabytes of binary that the seed reproduces
# exactly, so the repository carries the recipe rather than the output.
projects/*/app/assets/img/p/*
projects/*/app/assets/img/logo.png
projects/*/app/assets/fonts/*.woff2
# Stylesheets and scripts, generated by seed/assets.php. Same reasoning as the
# images above: the repository carries the recipe, not the output. They are a
# quarter of a megabyte of deterministic CSS and JavaScript that any checkout
# reproduces exactly.
projects/*/app/assets/css/*.css
projects/*/app/assets/js/*.js
projects/*/app/favicon.ico
projects/*/app/apple-touch-icon.png
